# Default: surfpool (mainnet-fork local com Kamino real, ideal pra dev diario).
# Pre-req: rodar `just surfpool-start` no diretorio anemone/ antes do `yarn dev`.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_NETWORK=surfpool

# Pra demo publica trocar pra:
#   NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
#   NEXT_PUBLIC_NETWORK=devnet
# Pos-audit:
#   NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com  (ou Helius/Triton)
#   NEXT_PUBLIC_NETWORK=mainnet

