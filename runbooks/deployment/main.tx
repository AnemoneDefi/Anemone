################################################################
# Manage anemone-surf deployment through Crypto Infrastructure as Code
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_anemone" "svm::deploy_program" {
    description = "Deploy anemone program"
    program = svm::get_program_from_anchor_project("anemone") 
    authority = signer.authority
    payer = signer.payer
    // Use surfnet cheatcode: writes program data directly, bypasses BPF Loader upload.
    instant_surfnet_deployment = true
}
